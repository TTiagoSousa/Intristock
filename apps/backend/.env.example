# Desenvolvimento local. Na VM o instalador gera /etc/intristock/backend.env.
NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://utilizador:password@localhost:5432/intristock"
FRONTEND_URL="http://localhost:5173"

# Em produção (NODE_ENV=production) o backend não arranca com estes valores de
# exemplo nem com segredos de menos de 32 caracteres: `openssl rand -base64 48`
JWT_SECRET="troca-isto"
JWT_USER_SECRET="troca-isto-tambem"

# Cifra as chaves das APIs guardadas na base de dados (Definições → APIs). Nunca mudar
# depois de haver chaves gravadas.
ENCRYPTION_KEY="troca-isto"

# Opcional em desenvolvimento: sem chaves na base de dados, as APIs usam estas
Currency_Api="https://api.currencybeacon.com/v1"
Currency_Api_Key=""
Country_Api="https://api.countrystatecity.in/v1"
Country_Api_Key=""
# Opcional: a CoinGecko funciona sem chave; a Demo (grátis) dá mais pedidos
Exchange_Api="https://api.coingecko.com/api/v3"
Exchange_Api_Key=""

# Storage dos documentos (S3 — Garage, MinIO, R2…)
S3_PROVIDER="garage"
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_BUCKET="intristock"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Velas de mercado e resultados das simulações (ClickHouse). Usados pelas apps Python
# (apps/downloader e apps/simulator), que leem este mesmo ficheiro
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DATABASE="intristock"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# Opcional: o estado do último backup da VM (o backup.sh escreve-o; falhado = aviso aos
# admins). Por omissão /var/lib/intristock-state/backup.json; sem ficheiro não faz nada.
# BACKUP_STATUS_FILE="/var/lib/intristock-state/backup.json"
