# Normaliza fins de linha no repositório.
* text=auto

# Os scripts correm no Linux da VM: com CRLF o bash parte ("$'\r': command not found").
*.sh text eol=lf
*.cjs text eol=lf

# Binários: nunca mexer nos fins de linha nem tentar fazer diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
